# Neon Postgres connectiestring (zie Neon-dashboard → Connection Details)
DATABASE_URL=postgresql://user:pass@host/database?sslmode=require

# Geheim voor het ondertekenen van sessies (Better Auth). Genereer er een met: openssl rand -base64 32
# Zet dezelfde waarde in de omgevingsvariabelen van elke omgeving (bijv. Vercel).
BETTER_AUTH_SECRET=
# Optioneel: de basis-URL van het platform. Zonder deze waarde wordt hij uit het verzoek afgeleid.
# BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 voor uploads (Instellingen → Koppelingen toont of dit werkt).
# Maak in het R2-dashboard een bucket en een API-token met Object Read & Write, alleen voor die bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com (zonder bucketnaam)
R2_ENDPOINT=
R2_BUCKET=cms-media
# Openbare basis-URL van de bucket zonder slash aan het eind, bijv. https://media.<jouw-domein>
R2_PUBLIC_URL=

# Optioneel: sleutels voor koppelingen die later gebouwd worden.
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=

# Openbare sites: PLATFORM_HOSTS zijn de hosts van het beheer (komma-gescheiden, met poort waar nodig); elke andere host wordt als
# openbare site behandeld. Leeg = alles is beheer en er wordt nooit een openbare site getoond. Op Vercel: `*.vercel.app` (een regel met *. geldt voor alle
# subdomeinen) plus het eigen beheeradres.
# PREVIEW_DOMAIN: <sitenaam>.<PREVIEW_DOMAIN> toont de gepubliceerde site met die naam. Lokaal: localhost:3000 voor beide.
PLATFORM_HOSTS=
PREVIEW_DOMAIN=

# Eigen domeinen van klanten (Vercel). Zonder deze variabelen worden domeinen alleen opgeslagen, niet bij Vercel aangemeld.
# VERCEL_TOKEN: een token met rechten op het project (Vercel → Account Settings → Tokens). VERCEL_PROJECT_ID: id of naam van het project waar dit platform draait.
# VERCEL_TEAM_ID: alleen nodig als het project bij een team hoort.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
