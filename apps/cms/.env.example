# Railway (of lokaal voor ontwikkeling)
DATABASE_URI=postgresql://user:pass@localhost:5432/cms
PAYLOAD_SECRET=verander-mij

# Base-URL van de Astro-devserver, voor de "Voorbeeld bekijken"-knop op
# Pages (zie src/components/PagePreviewLink.tsx). Optioneel — leeg =
# http://localhost:4321 (de lokale site-devserver uit .claude/launch.json).
# NEXT_PUBLIC_SITE_PREVIEW_URL=http://localhost:4321

# Cloudflare R2 (media-opslag, zie doc §3 en payload.config.ts)
# Leeg laten = media wordt lokaal opgeslagen (prima voor development).
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxxxxx.r2.dev
