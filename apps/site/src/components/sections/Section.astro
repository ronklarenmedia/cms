---
// Sectie-niveau uit de hiërarchie: breedte, indeling en achtergrond,
// bevat 1 of meer bouwblokken. `divider` is bewust nog niet geïmplementeerd
// (gereserveerd voor een latere versie, zie doc §5).
export interface Props {
  width?: "full" | "contained" | "custom";
  layout?: "1-col" | "2-col-50-50" | "2-col-30-70";
  background?: string;
}

const { width = "contained", layout = "1-col", background } = Astro.props;
---

<div
  class:list={["section", `section--${width}`, `section--${layout}`]}
  style={background ? `background: ${background}` : undefined}
>
  <slot />
</div>

<style>
  .section--contained {
    max-width: var(--var-max-width-large, 1200px);
    margin-inline: auto;
  }
  .section--2-col-50-50 {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .section--2-col-30-70 {
    display: grid;
    grid-template-columns: 3fr 7fr;
  }
</style>
