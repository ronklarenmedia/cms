---
// Eén grid met een optionele span per afbeelding i.p.v. losse
// grid/masonry-varianten (zie apps/cms/src/blocks/gallery.ts).
export interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  columns?: "2" | "3" | "4";
  images: { image: { url: string; alt?: string | null }; caption?: string; span?: "normal" | "wide" | "tall" }[];
}

const { eyebrow, heading, subheading, columns = "3", images } = Astro.props;
---

<div class="gallery">
  {(eyebrow || heading || subheading) && (
    <div class="gallery__header">
      {eyebrow && <p class="gallery__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="gallery__heading">{heading}</h2>}
      {subheading && <p class="gallery__subheading">{subheading}</p>}
    </div>
  )}

  <div class:list={["gallery__grid", `gallery__grid--${columns}col`]}>
    {images.map((item) => (
      <figure class:list={["gallery__item", `gallery__item--${item.span || "normal"}`]}>
        <img class="gallery__image" src={item.image.url} alt={item.image.alt || item.caption || ""} />
        {item.caption && <figcaption class="gallery__caption">{item.caption}</figcaption>}
      </figure>
    ))}
  </div>
</div>

<style>
  .gallery__header {
    text-align: center;
    max-width: var(--var-max-width-small, 640px);
    margin: 0 auto var(--var-spacing-xl, 3rem);
  }
  .gallery__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .gallery__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .gallery__subheading {
    opacity: 0.75;
    margin: 0;
  }

  .gallery__grid {
    display: grid;
    grid-auto-flow: dense;
    grid-auto-rows: 12rem;
    gap: var(--var-spacing-small, 0.5rem);
  }
  .gallery__grid--2col { grid-template-columns: repeat(2, 1fr); }
  .gallery__grid--3col { grid-template-columns: repeat(3, 1fr); }
  .gallery__grid--4col { grid-template-columns: repeat(4, 1fr); }

  .gallery__item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--var-border-radius-standard, 0.5rem);
  }
  .gallery__item--wide {
    grid-column: span 2;
  }
  .gallery__item--tall {
    grid-row: span 2;
  }
  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--var-spacing-small, 0.5rem) var(--var-spacing-standard, 1rem);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
    color: var(--var-color-white, #fff);
    font-size: var(--var-font-size-small, 0.875rem);
  }
</style>
