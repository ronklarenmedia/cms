---
// Native <details>/<summary> als accordion — geen client-JS nodig (zie
// apps/cms/src/blocks/faq.ts voor de 2 varianten).
export interface Props {
  variant?: "centered" | "split";
  eyebrow?: string;
  heading: string;
  subheading?: string;
  image?: { url: string; alt?: string | null } | null;
  items: { question: string; answer: string }[];
}

const { variant = "centered", eyebrow, heading, subheading, image, items } = Astro.props;
---

<div class:list={["faq", `faq--${variant}`]}>
  <div class="faq__intro">
    {eyebrow && <p class="faq__eyebrow">{eyebrow}</p>}
    <h2 class="faq__heading">{heading}</h2>
    {subheading && <p class="faq__subheading">{subheading}</p>}
    {variant === "split" && image?.url && <img class="faq__image" src={image.url} alt={image.alt || ""} />}
  </div>

  <div class="faq__accordion">
    {items.map((item) => (
      <details class="faq__item">
        <summary class="faq__question">
          {item.question}
          <span class="faq__icon" aria-hidden="true"></span>
        </summary>
        <p class="faq__answer">{item.answer}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq--split {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--var-spacing-xl, 3rem);
    align-items: start;
  }
  .faq--centered {
    max-width: var(--var-max-width-medium, 800px);
    margin: 0 auto;
  }
  .faq--centered .faq__intro {
    text-align: center;
    margin-bottom: var(--var-spacing-xl, 3rem);
  }

  .faq__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .faq__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .faq__subheading {
    opacity: 0.75;
    margin: 0;
  }
  .faq__image {
    width: 100%;
    aspect-ratio: var(--var-aspect-ratio-photo, 4/3);
    object-fit: cover;
    border-radius: var(--var-border-radius-medium, 0.75rem);
    margin-top: var(--var-spacing-large, 2rem);
  }

  .faq__accordion {
    display: flex;
    flex-direction: column;
  }
  .faq__item {
    border-bottom: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
    padding: var(--var-spacing-standard, 1rem) 0;
  }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--var-spacing-standard, 1rem);
    cursor: pointer;
    font-weight: var(--var-font-weight-bold, 600);
    list-style: none;
  }
  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
    transition: var(--var-transition-standard, 200ms ease);
  }
  .faq__icon::before {
    width: 100%;
    height: 2px;
  }
  .faq__icon::after {
    width: 2px;
    height: 100%;
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }
  .faq__answer {
    margin: var(--var-spacing-small, 0.5rem) 0 0;
    opacity: 0.75;
    line-height: var(--var-line-height-relaxed, 1.6);
  }
</style>
