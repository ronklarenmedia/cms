---
// Eerste bouwblok als voorbeeld/skelet: varianten zijn een instellingenveld
// op dit ene component, geen apart component per variant (zie doc §7).
//
// "centered-proof" + badge/cta/stats toegevoegd n.a.v. analyse van een
// Elementor-hero (starter-templates.com/kitkit/k1780). Elementor rendert
// zoiets normaliter met een stapel geneste div's; hier bewust plat
// gehouden met semantische elementen (dl/dt/dd voor de statistieken,
// geen wrapper-div's per item).
export interface Props {
  variant?: "centered" | "centered-proof" | "split" | "video-bg" | "full-bleed";
  heading: string;
  subheading?: string;
  image?: { url: string; alt?: string | null } | null;
  badge?: string;
  cta?: { label?: string; href?: string };
  stats?: { value: string; label: string }[];
}

const { variant = "centered", heading, subheading, image, badge, cta, stats } = Astro.props;
---

<section class:list={["hero", `hero--${variant}`]}>
  {badge && <p class="hero__badge">{badge}</p>}
  <h1>{heading}</h1>
  {subheading && <p class="hero__subheading">{subheading}</p>}
  {cta?.label && cta?.href && (
    <a class="hero__cta" href={cta.href}>{cta.label}</a>
  )}
  {image?.url && <img class="hero__image" src={image.url} alt={image.alt || ""} />}
  {stats && stats.length > 0 && (
    <dl class="hero__stats">
      {stats.map((stat) => (
        <>
          <dt>{stat.value}</dt>
          <dd>{stat.label}</dd>
        </>
      ))}
    </dl>
  )}
</section>

<style>
  .hero {
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .hero--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    text-align: left;
    align-items: center;
  }
  .hero__badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: var(--var-border-radius-full, 999px);
    background: var(--var-color-bg-secondary-light, #eef2ff);
    color: var(--var-color-secondary, #3730a3);
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
  }
  .hero__subheading {
    max-width: 40rem;
    margin-inline: auto;
    opacity: 0.75;
  }
  .hero--split .hero__subheading {
    margin-inline: 0;
  }
  .hero__cta {
    display: inline-block;
    margin-top: var(--var-spacing-standard, 1rem);
    padding: 0.75rem 1.75rem;
    border-radius: var(--var-border-radius-standard, 0.5rem);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    font-weight: var(--var-font-weight-bold, 600);
    text-decoration: none;
    transition: var(--var-transition-standard, 200ms ease);
  }
  .hero__image {
    max-width: 100%;
    margin-top: 2rem;
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1.5rem;
    max-width: 40rem;
    margin: 2.5rem auto 0;
    padding: 0;
  }
  .hero__stats dt {
    font-size: 1.75rem;
    font-weight: 700;
  }
  .hero__stats dd {
    margin: 0;
    opacity: 0.7;
    font-size: 0.875rem;
  }
</style>
