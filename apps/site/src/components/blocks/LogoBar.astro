---
// Rij klant-/partnerlogo's (zie apps/cms/src/blocks/logoBar.ts).
export interface Props {
  heading?: string;
  logos: { image?: { url: string; alt?: string | null } | null; name?: string; href?: string }[];
}

const { heading, logos } = Astro.props;
---

<div class="logo-bar">
  {heading && <p class="logo-bar__heading">{heading}</p>}
  <div class="logo-bar__logos">
    {logos.map((logo) => (
      logo.href ? (
        <a class="logo-bar__link" href={logo.href}>
          {logo.image?.url && <img class="logo-bar__image" src={logo.image.url} alt={logo.name || ""} />}
        </a>
      ) : (
        logo.image?.url && <img class="logo-bar__image" src={logo.image.url} alt={logo.name || ""} />
      )
    ))}
  </div>
</div>

<style>
  .logo-bar {
    text-align: center;
  }
  .logo-bar__heading {
    font-size: var(--var-font-size-small, 0.875rem);
    opacity: 0.6;
    margin: 0 0 var(--var-spacing-standard, 1rem);
  }
  .logo-bar__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--var-spacing-large, 2rem);
  }
  .logo-bar__image {
    height: 2rem;
    width: auto;
    object-fit: contain;
    opacity: 0.8;
  }
</style>
