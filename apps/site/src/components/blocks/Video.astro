---
// Native <video> bij een geüpload bestand, anders een poster met play-knop
// die naar de externe link linkt (zie apps/cms/src/blocks/video.ts).
export interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  poster: { url: string; alt?: string | null };
  videoFile?: { url: string } | null;
  videoUrl?: string;
  features?: { icon?: string; title: string; text?: string }[];
}

const { eyebrow, heading, subheading, poster, videoFile, videoUrl, features } = Astro.props;
---

<div class="video-block">
  {(eyebrow || heading || subheading) && (
    <div class="video-block__header">
      {eyebrow && <p class="video-block__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="video-block__heading">{heading}</h2>}
      {subheading && <p class="video-block__subheading">{subheading}</p>}
    </div>
  )}

  <div class="video-block__frame">
    {videoFile?.url ? (
      <video class="video-block__video" src={videoFile.url} poster={poster.url} controls></video>
    ) : (
      <a class="video-block__poster-link" href={videoUrl || "#"} target="_blank" rel="noopener noreferrer">
        <img class="video-block__poster" src={poster.url} alt={poster.alt || ""} />
        <span class="video-block__play" aria-hidden="true">▶</span>
      </a>
    )}
  </div>

  {features && features.length > 0 && (
    <div class="video-block__features">
      {features.map((f) => (
        <div class="video-block__feature">
          {f.icon && <span class="video-block__feature-icon" aria-hidden="true">{f.icon}</span>}
          <p class="video-block__feature-title">{f.title}</p>
          {f.text && <p class="video-block__feature-text">{f.text}</p>}
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .video-block__header {
    text-align: center;
    max-width: var(--var-max-width-small, 640px);
    margin: 0 auto var(--var-spacing-xl, 3rem);
  }
  .video-block__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .video-block__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .video-block__subheading {
    opacity: 0.75;
    margin: 0;
  }

  .video-block__frame {
    position: relative;
    border-radius: var(--var-border-radius-large, 1rem);
    overflow: hidden;
  }
  .video-block__video {
    width: 100%;
    display: block;
    aspect-ratio: var(--var-aspect-ratio-video, 16/9);
  }
  .video-block__poster-link {
    position: relative;
    display: block;
  }
  .video-block__poster {
    width: 100%;
    aspect-ratio: var(--var-aspect-ratio-video, 16/9);
    object-fit: cover;
    display: block;
  }
  .video-block__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--var-border-radius-full, 999px);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    font-size: 1.25rem;
    transition: var(--var-transition-standard, 200ms ease);
  }
  .video-block__poster-link:hover .video-block__play {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .video-block__features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--var-spacing-large, 2rem);
    text-align: center;
    margin-top: var(--var-spacing-xl, 3rem);
  }
  .video-block__feature-icon {
    display: inline-block;
    font-size: var(--var-font-size-large, 1.5rem);
    color: var(--var-color-primary, #4338ca);
    margin-bottom: var(--var-spacing-xs, 0.25rem);
  }
  .video-block__feature-title {
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0;
  }
  .video-block__feature-text {
    margin: 0.15rem 0 0;
    opacity: 0.7;
    font-size: var(--var-font-size-small, 0.875rem);
  }
</style>
