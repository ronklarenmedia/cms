---
// Introblok boven een sectie: kicker + kop + subkop, links of gecentreerd
// (zie apps/cms/src/blocks/sectionHeading.ts).
export interface Props {
  align?: "left" | "center";
  eyebrow?: string;
  heading: string;
  subheading?: string;
}

const { align = "center", eyebrow, heading, subheading } = Astro.props;
---

<div class:list={["section-heading", `section-heading--${align}`]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2 class="section-heading__heading">{heading}</h2>
  {subheading && <p class="section-heading__subheading">{subheading}</p>}
</div>

<style>
  .section-heading--center {
    text-align: center;
    max-width: var(--var-max-width-small, 640px);
    margin-inline: auto;
  }
  .section-heading__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .section-heading__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .section-heading__subheading {
    font-size: var(--var-font-size-medium, 1.125rem);
    opacity: 0.75;
    margin: 0;
  }
</style>
