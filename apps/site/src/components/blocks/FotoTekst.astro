---
// Foto + tekst, met "imagePosition" als instellingenveld i.p.v. twee
// aparte bloktypes (zie apps/cms/src/blocks/fotoTekst.ts).
export interface Props {
  imagePosition?: "left" | "right";
  image?: { url: string; alt?: string | null } | null;
  heading?: string;
  text?: string;
}

const { imagePosition = "left", image, heading, text } = Astro.props;
---

<div class:list={["foto-tekst", `foto-tekst--${imagePosition}`]}>
  {image?.url && <img class="foto-tekst__image" src={image.url} alt={image.alt || ""} />}
  <div class="foto-tekst__content">
    {heading && <h2 class="foto-tekst__heading">{heading}</h2>}
    {text && <p class="foto-tekst__text">{text}</p>}
  </div>
</div>

<style>
  .foto-tekst {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--var-spacing-large, 2rem);
    align-items: center;
  }
  .foto-tekst--right {
    direction: rtl;
  }
  .foto-tekst--right > * {
    direction: ltr;
  }
  .foto-tekst__image {
    width: 100%;
    height: auto;
    border-radius: var(--var-border-radius-medium, 0.75rem);
  }
  .foto-tekst__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .foto-tekst__text {
    font-size: var(--var-font-size-standard, 1rem);
    line-height: var(--var-line-height-standard, 1.5);
    opacity: 0.85;
    margin: 0;
  }
</style>
