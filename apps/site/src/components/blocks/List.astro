---
// 2 varianten (zie apps/cms/src/blocks/list.ts).
export interface Props {
  variant?: "detailed" | "simple";
  eyebrow?: string;
  heading: string;
  items: { tag?: string; title: string; text?: string; href?: string; tags?: { text: string }[] }[];
}

const { variant = "detailed", eyebrow, heading, items } = Astro.props;
---

<div class="list-block">
  <div class="list-block__header">
    {eyebrow && <p class="list-block__eyebrow">{eyebrow}</p>}
    <h2 class="list-block__heading">{heading}</h2>
  </div>

  <div class="list-block__rows">
    {items.map((item) => (
      <div class:list={["list-block__row", `list-block__row--${variant}`]}>
        {variant === "detailed" && (
          <>
            {item.tag && <span class="list-block__tag">{item.tag}</span>}
            <div class="list-block__body">
              <p class="list-block__title">{item.title}</p>
              {item.text && <p class="list-block__text">{item.text}</p>}
            </div>
            {item.href && <a class="list-block__arrow" href={item.href} aria-label={item.title}>→</a>}
          </>
        )}
        {variant === "simple" && (
          <>
            <p class="list-block__title">{item.title}</p>
            {item.tags && item.tags.length > 0 && (
              <div class="list-block__tags">
                {item.tags.map((t) => <span class="list-block__tag-pill">{t.text}</span>)}
              </div>
            )}
          </>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .list-block__header {
    margin-bottom: var(--var-spacing-xl, 3rem);
  }
  .list-block__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .list-block__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0;
  }

  .list-block__rows {
    display: flex;
    flex-direction: column;
  }
  .list-block__row {
    padding: var(--var-spacing-standard, 1rem) 0;
    border-top: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
  }
  .list-block__rows > .list-block__row:last-child {
    border-bottom: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
  }

  .list-block__row--detailed {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    gap: var(--var-spacing-standard, 1rem);
    align-items: center;
  }
  .list-block__tag {
    opacity: 0.5;
    font-size: var(--var-font-size-small, 0.875rem);
  }
  .list-block__title {
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 0.2rem;
  }
  .list-block__text {
    margin: 0;
    opacity: 0.7;
    font-size: var(--var-font-size-small, 0.875rem);
  }
  .list-block__arrow {
    color: var(--var-color-primary, #4338ca);
    font-size: var(--var-font-size-medium, 1.125rem);
    text-decoration: none;
  }

  .list-block__row--simple {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--var-spacing-standard, 1rem);
  }
  .list-block__tags {
    display: flex;
    gap: var(--var-spacing-standard, 1rem);
  }
  .list-block__tag-pill {
    opacity: 0.6;
    font-size: var(--var-font-size-small, 0.875rem);
  }
</style>
