---
// 3 varianten op één blocktype (zie apps/cms/src/blocks/contact.ts).
// Het formulier is decoratief/statisch tenzij formAction is ingevuld —
// echte verwerking is geen onderdeel van dit content-block.
export interface Props {
  variant?: "formInfo" | "split" | "locations";
  eyebrow?: string;
  heading: string;
  subheading?: string;
  image?: { url: string; alt?: string | null } | null;
  submitLabel?: string;
  formAction?: string;
  contactInfo?: { icon?: string; label: string; value: string }[];
  locations?: {
    name: string;
    phone?: string;
    email?: string;
    address?: string;
    cta?: { label?: string; href?: string };
  }[];
}

const {
  variant = "formInfo",
  eyebrow,
  heading,
  subheading,
  image,
  submitLabel = "Verstuur bericht",
  formAction,
  contactInfo,
  locations,
} = Astro.props;
---

<div class:list={["contact", `contact--${variant}`]}>
  {variant === "formInfo" && (
    <div class="contact__intro">
      {eyebrow && <p class="contact__eyebrow">{eyebrow}</p>}
      <h2 class="contact__heading">{heading}</h2>
      {subheading && <p class="contact__subheading">{subheading}</p>}
    </div>
  )}

  {variant === "formInfo" && (
    <div class="contact__grid">
      <form class="contact__form" action={formAction || undefined} method="post">
        <div class="contact__row">
          <input class="contact__input" type="text" name="name" placeholder="Naam" />
          <input class="contact__input" type="text" name="company" placeholder="Bedrijfsnaam" />
        </div>
        <div class="contact__row">
          <input class="contact__input" type="tel" name="phone" placeholder="Telefoon" />
          <input class="contact__input" type="email" name="email" placeholder="E-mail" />
        </div>
        <textarea class="contact__textarea" name="message" placeholder="Je bericht"></textarea>
        <button class="contact__submit" type="submit">{submitLabel}</button>
      </form>
      {contactInfo && contactInfo.length > 0 && (
        <div class="contact__card">
          {contactInfo.map((item) => (
            <div class="contact__card-item">
              {item.icon && <span class="contact__card-icon" aria-hidden="true">{item.icon}</span>}
              <div>
                <p class="contact__card-label">{item.label}</p>
                <p class="contact__card-value">{item.value}</p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  {variant === "split" && (
    <div class="contact__split">
      {image?.url && <img class="contact__split-image" src={image.url} alt={image.alt || ""} />}
      <div class="contact__split-form">
        {eyebrow && <p class="contact__eyebrow">{eyebrow}</p>}
        <h2 class="contact__heading">{heading}</h2>
        {subheading && <p class="contact__subheading">{subheading}</p>}
        <form class="contact__form" action={formAction || undefined} method="post">
          <div class="contact__row">
            <input class="contact__input" type="text" name="name" placeholder="Naam" />
            <input class="contact__input" type="email" name="email" placeholder="E-mail" />
          </div>
          <textarea class="contact__textarea" name="message" placeholder="Je bericht"></textarea>
          <button class="contact__submit" type="submit">{submitLabel}</button>
        </form>
      </div>
    </div>
  )}

  {variant === "locations" && (
    <div class="contact__locations">
      <div class="contact__intro">
        {eyebrow && <p class="contact__eyebrow">{eyebrow}</p>}
        <h2 class="contact__heading">{heading}</h2>
        {subheading && <p class="contact__subheading">{subheading}</p>}
      </div>
      <div class="contact__locations-grid">
        {locations?.map((loc) => (
          <div class="contact__location">
            <h3 class="contact__location-name">{loc.name}</h3>
            {loc.phone && <p class="contact__location-line">{loc.phone}</p>}
            {loc.email && <p class="contact__location-line">{loc.email}</p>}
            {loc.address && <p class="contact__location-line">{loc.address}</p>}
            {loc.cta?.label && loc.cta?.href && (
              <a class="contact__location-cta" href={loc.cta.href}>{loc.cta.label}</a>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .contact__intro {
    margin-bottom: var(--var-spacing-xl, 3rem);
  }
  .contact__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .contact__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .contact__subheading {
    font-size: var(--var-font-size-medium, 1.125rem);
    opacity: 0.75;
    margin: 0;
    max-width: var(--var-max-width-small, 640px);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--var-spacing-xl, 3rem);
    align-items: start;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--var-spacing-standard, 1rem);
  }
  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--var-spacing-standard, 1rem);
  }
  .contact__input,
  .contact__textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #d1d5db);
    border-radius: var(--var-border-radius-standard, 0.5rem);
    font-family: inherit;
    font-size: var(--var-font-size-standard, 1rem);
    background: var(--var-color-white, #fff);
    color: var(--var-color-text, #1e293b);
  }
  .contact__textarea {
    min-height: 8rem;
    resize: vertical;
  }
  .contact__submit {
    align-self: flex-start;
    padding: 0.75rem 1.75rem;
    border: none;
    border-radius: var(--var-border-radius-standard, 0.5rem);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    font-weight: var(--var-font-weight-bold, 600);
    font-size: var(--var-font-size-standard, 1rem);
    cursor: pointer;
    transition: var(--var-transition-standard, 200ms ease);
  }

  .contact__card {
    display: flex;
    flex-direction: column;
    gap: var(--var-spacing-large, 2rem);
    padding: var(--var-spacing-large, 2rem);
    border-radius: var(--var-border-radius-medium, 0.75rem);
    background: var(--var-color-bg-secondary-light, #f8fafc);
  }
  .contact__card-item {
    display: flex;
    gap: var(--var-spacing-small, 0.5rem);
    align-items: flex-start;
  }
  .contact__card-icon {
    font-size: var(--var-font-size-medium, 1.125rem);
  }
  .contact__card-label {
    margin: 0;
    font-weight: var(--var-font-weight-bold, 600);
  }
  .contact__card-value {
    margin: 0;
    opacity: 0.75;
    font-size: var(--var-font-size-small, 0.875rem);
  }

  .contact__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--var-spacing-xl, 3rem);
    align-items: center;
  }
  .contact__split-image {
    width: 100%;
    aspect-ratio: var(--var-aspect-ratio-square, 1/1);
    object-fit: cover;
    border-radius: var(--var-border-radius-medium, 0.75rem);
  }

  .contact__locations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--var-spacing-large, 2rem);
  }
  .contact__location-name {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-medium, 1.125rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .contact__location-line {
    margin: 0;
    opacity: 0.75;
    font-size: var(--var-font-size-standard, 1rem);
  }
  .contact__location-cta {
    display: inline-block;
    margin-top: var(--var-spacing-small, 0.5rem);
    color: var(--var-color-primary, #4338ca);
    font-weight: var(--var-font-weight-bold, 600);
    text-decoration: none;
  }
</style>
