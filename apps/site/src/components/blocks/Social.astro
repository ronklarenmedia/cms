---
// 2 varianten (zie apps/cms/src/blocks/social.ts).
export interface Props {
  variant?: "bar" | "iconsRound";
  heading?: string;
  text?: string;
  links: { label: string; href: string }[];
}

const { variant = "bar", heading, text, links } = Astro.props;
---

<div class:list={["social", `social--${variant}`]}>
  {variant === "iconsRound" && (heading || text) && (
    <div class="social__intro">
      {heading && <p class="social__heading">{heading}</p>}
      {text && <p class="social__text">{text}</p>}
    </div>
  )}

  <div class="social__links">
    {links.map((link) => (
      <a class:list={["social__link", `social__link--${variant}`]} href={link.href} target="_blank" rel="noopener noreferrer">
        {link.label}
      </a>
    ))}
  </div>
</div>

<style>
  .social--bar .social__links {
    display: flex;
    flex-wrap: wrap;
  }
  .social__link--bar {
    flex: 1;
    min-width: 8rem;
    text-align: center;
    padding: var(--var-spacing-standard, 1rem);
    border: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
    color: inherit;
    text-decoration: none;
    font-weight: var(--var-font-weight-bold, 600);
    margin-left: -1px;
  }

  .social--iconsRound {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--var-spacing-standard, 1rem);
  }
  .social__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-large, 1.5rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0;
  }
  .social__text {
    margin: 0.25rem 0 0;
    opacity: 0.7;
    font-size: var(--var-font-size-small, 0.875rem);
  }
  .social--iconsRound .social__links {
    display: flex;
    gap: var(--var-spacing-small, 0.5rem);
  }
  .social__link--iconsRound {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--var-border-radius-full, 999px);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    text-decoration: none;
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
  }
</style>
