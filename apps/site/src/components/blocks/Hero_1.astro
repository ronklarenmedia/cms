---
// Hero.astro
// Astro component voor het "hero" Payload block (zie HeroBlock.ts).
// Verwacht de block-data zoals Payload die teruggeeft (media-relaties resolved
// naar { url, alt }) — pas de destructuring aan als je REST/Local API iets
// anders serialiseert (bv. media.url vs media.sizes.card.url).

interface MediaLike {
  url: string
  alt?: string
}

interface GalleryColumn {
  layout: 'tall' | 'half'
  image?: MediaLike
  imageTop?: MediaLike
  imageBottom?: MediaLike
}

interface Stat {
  value: string
  label: string
}

interface Props {
  heading: string
  subheading?: string
  showSocialProof?: boolean
  avatars?: { image: MediaLike }[]
  rating?: number
  trustText?: string
  ctaLabel?: string
  ctaLink?: string
  images?: GalleryColumn[]
  showBottomBar?: boolean
  bottomHeading?: string
  stats?: Stat[]
  backgroundColor?: string
}

const {
  heading,
  subheading,
  showSocialProof = true,
  avatars = [],
  rating = 0,
  trustText,
  ctaLabel,
  ctaLink = '#',
  images = [],
  showBottomBar = true,
  bottomHeading,
  stats = [],
  backgroundColor = '#f7f7f7',
} = Astro.props as Props

const fullStars = Math.floor(rating)
const hasHalfStar = rating - fullStars >= 0.5
const starIndices = [0, 1, 2, 3, 4]
---

<section class="hero" style={`--hero-bg: ${backgroundColor}`}>
  <div class="hero__inner">
    <div class="hero__top">
      <div class="hero__intro">
        <h1 class="hero__heading">{heading}</h1>
        {subheading && <p class="hero__subheading">{subheading}</p>}
      </div>

      <div class="hero__actions">
        {showSocialProof && (
          <div class="hero__proof">
            {avatars.length > 0 && (
              <div class="hero__avatars">
                {avatars.map((a) => (
                  <img class="hero__avatar" src={a.image?.url} alt={a.image?.alt || ''} loading="lazy" />
                ))}
              </div>
            )}
            <div class="hero__proof-text">
              {rating > 0 && (
                <div class="hero__stars" aria-label={`${rating} van de 5 sterren`}>
                  {starIndices.map((i) => (
                    <span class:list={['hero__star', { 'hero__star--full': i < fullStars, 'hero__star--half': i === fullStars && hasHalfStar }]}>★</span>
                  ))}
                </div>
              )}
              {trustText && <span class="hero__trust-text">{trustText}</span>}
            </div>
          </div>
        )}
        {ctaLabel && (
          <a class="hero__cta" href={ctaLink}>{ctaLabel}</a>
        )}
      </div>
    </div>

    {images.length > 0 && (
      <div class="hero__gallery">
        {images.map((col) => (
          col.layout === 'half' ? (
            <div class="hero__col hero__col--split">
              {col.imageTop && <img src={col.imageTop.url} alt={col.imageTop.alt || ''} loading="lazy" />}
              {col.imageBottom && <img src={col.imageBottom.url} alt={col.imageBottom.alt || ''} loading="lazy" />}
            </div>
          ) : (
            <div class="hero__col hero__col--tall">
              {col.image && <img src={col.image.url} alt={col.image.alt || ''} loading="lazy" />}
            </div>
          )
        ))}
      </div>
    )}

    {showBottomBar && (bottomHeading || stats.length > 0) && (
      <div class="hero__bottom">
        {bottomHeading && <p class="hero__bottom-heading">{bottomHeading}</p>}
        {stats.length > 0 && (
          <div class="hero__stats">
            {stats.map((s) => (
              <div class="hero__stat">
                <span class="hero__stat-value">{s.value}</span>
                <span class="hero__stat-label">{s.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    background: var(--hero-bg, #f7f7f7);
    padding: clamp(2.5rem, 5vw, 5rem) clamp(1.25rem, 4vw, 3rem);
  }

  .hero__inner {
    max-width: 1290px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .hero__intro {
    max-width: 34rem;
  }

  .hero__heading {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .hero__subheading {
    font-size: 1rem;
    line-height: 1.6;
    color: #6b6b6b;
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 14rem;
  }

  .hero__proof {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__avatars {
    display: flex;
  }

  .hero__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid var(--hero-bg, #f7f7f7);
    margin-left: -0.6rem;
  }

  .hero__avatar:first-child {
    margin-left: 0;
  }

  .hero__proof-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__stars {
    color: #e5e5e5;
    font-size: 0.9rem;
    letter-spacing: 0.1rem;
  }

  .hero__star--full,
  .hero__star--half {
    color: #f1b170;
  }

  .hero__trust-text {
    font-size: 0.85rem;
    color: #6b6b6b;
  }

  .hero__cta {
    display: inline-block;
    background: #f1b170;
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: filter 0.15s ease;
  }

  .hero__cta:hover {
    filter: brightness(0.94);
  }

  .hero__gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1.875rem;
  }

  .hero__col {
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }

  .hero__col img {
    width: 100%;
    border-radius: 20px;
    object-fit: cover;
    display: block;
  }

  .hero__col--tall img {
    height: 100%;
    aspect-ratio: 3 / 5;
  }

  .hero__col--split img {
    flex: 1;
    aspect-ratio: 1 / 1;
  }

  .hero__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__bottom-heading {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    max-width: 20rem;
  }

  .hero__stats {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
  }

  .hero__stat-value {
    font-size: 1.6rem;
    font-weight: 700;
  }

  .hero__stat-label {
    font-size: 0.8rem;
    color: #6b6b6b;
  }

  @media (max-width: 900px) {
    .hero__gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
    }

    .hero__col--tall {
      grid-column: span 2;
    }

    .hero__col--tall img {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 520px) {
    .hero__gallery {
      grid-template-columns: 1fr;
    }

    .hero__col--tall {
      grid-column: span 1;
    }
  }
</style>
