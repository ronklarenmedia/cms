---
// 2 varianten (zie apps/cms/src/blocks/timeline.ts).
export interface Props {
  variant?: "horizontal" | "vertical";
  eyebrow?: string;
  heading: string;
  subheading?: string;
  items: { date: string; icon?: string; title: string; text?: string; cta?: { label?: string; href?: string } }[];
}

const { variant = "horizontal", eyebrow, heading, subheading, items } = Astro.props;
---

<div class="timeline">
  <div class="timeline__header">
    {eyebrow && <p class="timeline__eyebrow">{eyebrow}</p>}
    <h2 class="timeline__heading">{heading}</h2>
    {subheading && <p class="timeline__subheading">{subheading}</p>}
  </div>

  {variant === "horizontal" && (
    <div class="timeline__row">
      {items.map((item) => (
        <div class="timeline__col">
          <p class="timeline__date">{item.date}</p>
          <hr class="timeline__rule" />
          <p class="timeline__title">{item.title}</p>
          {item.text && <p class="timeline__text">{item.text}</p>}
          {item.cta?.label && item.cta?.href && (
            <a class="timeline__link" href={item.cta.href}>{item.cta.label} →</a>
          )}
        </div>
      ))}
    </div>
  )}

  {variant === "vertical" && (
    <div class="timeline__vertical">
      {items.map((item, i) => (
        <div class:list={["timeline__node", i % 2 === 0 ? "timeline__node--left" : "timeline__node--right"]}>
          <div class="timeline__card">
            <p class="timeline__card-header">
              {item.icon && <span aria-hidden="true">{item.icon}</span>}
              <span class="timeline__title">{item.title}</span>
            </p>
            <p class="timeline__date">{item.date}</p>
            {item.text && <p class="timeline__text">{item.text}</p>}
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .timeline__header {
    text-align: center;
    max-width: var(--var-max-width-small, 640px);
    margin: 0 auto var(--var-spacing-xl, 3rem);
  }
  .timeline__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .timeline__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .timeline__subheading {
    opacity: 0.75;
    margin: 0;
  }

  .timeline__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--var-spacing-large, 2rem);
  }
  .timeline__date {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-medium, 1.125rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .timeline__rule {
    border: none;
    border-top: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .timeline__title {
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 0.25rem;
  }
  .timeline__text {
    margin: 0;
    opacity: 0.7;
    font-size: var(--var-font-size-small, 0.875rem);
  }
  .timeline__link {
    display: inline-block;
    margin-top: var(--var-spacing-small, 0.5rem);
    color: var(--var-color-primary, #4338ca);
    font-weight: var(--var-font-weight-bold, 600);
    font-size: var(--var-font-size-small, 0.875rem);
    text-decoration: none;
  }

  .timeline__vertical {
    position: relative;
    max-width: var(--var-max-width-medium, 800px);
    margin: 0 auto;
    padding-left: 1px;
  }
  .timeline__vertical::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--var-border-width-thin, 1px);
    background: var(--var-color-light-grey, #e2e8f0);
  }
  .timeline__node {
    position: relative;
    width: 50%;
    padding: 0 var(--var-spacing-xl, 3rem) var(--var-spacing-large, 2rem);
  }
  .timeline__node--left {
    margin-left: 0;
    text-align: right;
  }
  .timeline__node--right {
    margin-left: 50%;
    text-align: left;
  }
  .timeline__card {
    display: inline-block;
    text-align: left;
    padding: var(--var-spacing-standard, 1rem);
    border-radius: var(--var-border-radius-medium, 0.75rem);
    background: var(--var-color-bg-secondary-light, #f8fafc);
  }
  .timeline__card-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }
  .timeline__card .timeline__date {
    font-size: var(--var-font-size-small, 0.875rem);
    opacity: 0.6;
    margin: 0.15rem 0 0.4rem;
  }
</style>
