---
// Grid of één grote quote (zie apps/cms/src/blocks/testimonials.ts).
export interface Props {
  layout?: "grid" | "single";
  items: {
    quote: string;
    name: string;
    role?: string;
    avatar?: { url: string; alt?: string | null } | null;
    rating?: number;
  }[];
}

const { layout = "grid", items } = Astro.props;
---

<div class:list={["testimonials", `testimonials--${layout}`]}>
  {items.map((item) => (
    <figure class="testimonials__item">
      {item.rating && (
        <div class="testimonials__rating" aria-hidden="true">{"★".repeat(item.rating)}</div>
      )}
      <blockquote class="testimonials__quote">{item.quote}</blockquote>
      <figcaption class="testimonials__author">
        {item.avatar?.url && <img class="testimonials__avatar" src={item.avatar.url} alt="" />}
        <span class="testimonials__name">{item.name}</span>
        {item.role && <span class="testimonials__role">{item.role}</span>}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .testimonials--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--var-spacing-large, 2rem);
  }
  .testimonials--single {
    max-width: var(--var-max-width-small, 640px);
    margin-inline: auto;
    text-align: center;
  }
  .testimonials__item {
    margin: 0;
    padding: var(--var-spacing-standard, 1rem);
  }
  .testimonials__rating {
    color: var(--var-color-warning, #f59e0b);
    margin-bottom: var(--var-spacing-xs, 0.25rem);
  }
  .testimonials__quote {
    margin: 0 0 var(--var-spacing-standard, 1rem);
    font-size: var(--var-font-size-medium, 1.125rem);
    line-height: var(--var-line-height-relaxed, 1.6);
  }
  .testimonials__author {
    display: flex;
    align-items: center;
    gap: var(--var-spacing-small, 0.5rem);
    justify-content: inherit;
  }
  .testimonials--grid .testimonials__author {
    justify-content: flex-start;
  }
  .testimonials__avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--var-border-radius-full, 999px);
    object-fit: cover;
  }
  .testimonials__name {
    font-weight: var(--var-font-weight-bold, 600);
  }
  .testimonials__role {
    opacity: 0.65;
    font-size: var(--var-font-size-small, 0.875rem);
  }
</style>
