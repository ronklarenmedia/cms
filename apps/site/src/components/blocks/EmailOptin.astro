---
// 2 varianten (zie apps/cms/src/blocks/emailOptin.ts). Statisch formulier
// tenzij formAction is ingevuld.
export interface Props {
  variant?: "centered" | "split";
  eyebrow?: string;
  heading: string;
  subheading?: string;
  image?: { url: string; alt?: string | null } | null;
  showNameField?: boolean;
  submitLabel?: string;
  formAction?: string;
  disclaimer?: string;
}

const {
  variant = "centered",
  eyebrow,
  heading,
  subheading,
  image,
  showNameField,
  submitLabel = "Aanmelden",
  formAction,
  disclaimer,
} = Astro.props;
---

<div class:list={["email-optin", `email-optin--${variant}`]}>
  {variant === "split" && image?.url && <img class="email-optin__image" src={image.url} alt={image.alt || ""} />}
  <div class="email-optin__content">
    {eyebrow && <p class="email-optin__eyebrow">{eyebrow}</p>}
    <h2 class="email-optin__heading">{heading}</h2>
    {subheading && <p class="email-optin__subheading">{subheading}</p>}
    <form class="email-optin__form" action={formAction || undefined} method="post">
      {showNameField && <input class="email-optin__input" type="text" name="name" placeholder="Naam" />}
      <input class="email-optin__input" type="email" name="email" placeholder="E-mailadres" required />
      <button class="email-optin__submit" type="submit">{submitLabel}</button>
    </form>
    {disclaimer && <p class="email-optin__disclaimer">{disclaimer}</p>}
  </div>
</div>

<style>
  .email-optin--centered {
    text-align: center;
    max-width: var(--var-max-width-medium, 800px);
    margin: 0 auto;
  }
  .email-optin--centered .email-optin__form {
    justify-content: center;
  }
  .email-optin--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--var-spacing-xl, 3rem);
    align-items: center;
  }
  .email-optin__image {
    width: 100%;
    aspect-ratio: var(--var-aspect-ratio-square, 1/1);
    object-fit: cover;
    border-radius: var(--var-border-radius-medium, 0.75rem);
  }

  .email-optin__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .email-optin__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .email-optin__subheading {
    opacity: 0.75;
    margin: 0 0 var(--var-spacing-large, 2rem);
  }

  .email-optin__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--var-spacing-small, 0.5rem);
  }
  .email-optin__input {
    flex: 1 1 12rem;
    padding: 0.75rem 1rem;
    border: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #d1d5db);
    border-radius: var(--var-border-radius-standard, 0.5rem);
    font-family: inherit;
    font-size: var(--var-font-size-standard, 1rem);
  }
  .email-optin__submit {
    padding: 0.75rem 1.75rem;
    border: none;
    border-radius: var(--var-border-radius-standard, 0.5rem);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    font-weight: var(--var-font-weight-bold, 600);
    cursor: pointer;
  }
  .email-optin__disclaimer {
    margin: var(--var-spacing-standard, 1rem) 0 0;
    font-size: var(--var-font-size-small, 0.875rem);
    opacity: 0.55;
  }
</style>
