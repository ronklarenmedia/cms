---
// Volledig-breed conversieblok (zie apps/cms/src/blocks/ctaBanner.ts).
export interface Props {
  style?: "solid" | "soft";
  heading: string;
  text?: string;
  cta?: { label?: string; href?: string };
  secondaryCta?: { label?: string; href?: string };
}

const { style = "solid", heading, text, cta, secondaryCta } = Astro.props;
---

<div class:list={["cta-banner", `cta-banner--${style}`]}>
  <h2 class="cta-banner__heading">{heading}</h2>
  {text && <p class="cta-banner__text">{text}</p>}
  <div class="cta-banner__actions">
    {cta?.label && cta?.href && (
      <a class="cta-banner__btn cta-banner__btn--primary" href={cta.href}>{cta.label}</a>
    )}
    {secondaryCta?.label && secondaryCta?.href && (
      <a class="cta-banner__btn cta-banner__btn--secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
    )}
  </div>
</div>

<style>
  .cta-banner {
    padding: var(--var-spacing-xl, 3rem) var(--var-spacing-large, 2rem);
    border-radius: var(--var-border-radius-medium, 0.75rem);
    text-align: center;
  }
  .cta-banner--solid {
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
  }
  .cta-banner--soft {
    background: var(--var-color-bg-primary-light, #eef2ff);
    color: var(--var-color-text, #1e293b);
  }
  .cta-banner__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .cta-banner__text {
    font-size: var(--var-font-size-medium, 1.125rem);
    opacity: 0.85;
    margin: 0 auto var(--var-spacing-standard, 1rem);
    max-width: var(--var-max-width-small, 640px);
  }
  .cta-banner__actions {
    display: flex;
    gap: var(--var-spacing-small, 0.5rem);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--var-spacing-standard, 1rem);
  }
  .cta-banner__btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: var(--var-border-radius-standard, 0.5rem);
    font-weight: var(--var-font-weight-bold, 600);
    text-decoration: none;
    transition: var(--var-transition-standard, 200ms ease);
  }
  .cta-banner--solid .cta-banner__btn--primary {
    background: var(--var-color-white, #fff);
    color: var(--var-color-primary, #4338ca);
  }
  .cta-banner--soft .cta-banner__btn--primary {
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
  }
  .cta-banner__btn--secondary {
    background: transparent;
    border: var(--var-border-width-thin, 1px) solid currentColor;
    color: inherit;
  }
</style>
