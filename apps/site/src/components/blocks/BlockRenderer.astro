---
// Eén schakelpunt tussen Payload's block-data (blockType) en het bijbehorende
// Astro-component. Nieuw block toevoegen = hier één regel bij (zie
// apps/cms/src/blocks/index.ts voor de brontypes).
import Hero from "./Hero.astro";
import FotoTekst from "./FotoTekst.astro";
import SectionHeading from "./SectionHeading.astro";
import UspGrid from "./UspGrid.astro";
import Stats from "./Stats.astro";
import CtaBanner from "./CtaBanner.astro";
import Testimonials from "./Testimonials.astro";
import LogoBar from "./LogoBar.astro";
import Contact from "./Contact.astro";
import StepBox from "./StepBox.astro";
import TeamGrid from "./TeamGrid.astro";
import PricingTable from "./PricingTable.astro";
import Gallery from "./Gallery.astro";
import Faq from "./Faq.astro";
import List from "./List.astro";
import RichText from "./RichText.astro";
import Video from "./Video.astro";
import EmailOptin from "./EmailOptin.astro";
import PriceList from "./PriceList.astro";
import Timeline from "./Timeline.astro";
import Social from "./Social.astro";

export interface Props {
  block: Record<string, any>;
}

const { block } = Astro.props;
---

{block.blockType === "hero" && (
  <Hero
    variant={block.variant}
    heading={block.heading}
    subheading={block.subheading}
    image={block.image}
    badge={block.badge}
    cta={block.cta}
    stats={block.stats}
  />
)}
{block.blockType === "fotoTekst" && (
  <FotoTekst imagePosition={block.imagePosition} image={block.image} heading={block.heading} text={block.text} />
)}
{block.blockType === "sectionHeading" && (
  <SectionHeading align={block.align} eyebrow={block.eyebrow} heading={block.heading} subheading={block.subheading} />
)}
{block.blockType === "uspGrid" && <UspGrid columns={block.columns} items={block.items} />}
{block.blockType === "stats" && <Stats items={block.items} />}
{block.blockType === "ctaBanner" && (
  <CtaBanner style={block.style} heading={block.heading} text={block.text} cta={block.cta} secondaryCta={block.secondaryCta} />
)}
{block.blockType === "testimonials" && <Testimonials layout={block.layout} items={block.items} />}
{block.blockType === "logoBar" && <LogoBar heading={block.heading} logos={block.logos} />}
{block.blockType === "contact" && (
  <Contact
    variant={block.variant}
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    image={block.image}
    submitLabel={block.submitLabel}
    formAction={block.formAction}
    contactInfo={block.contactInfo}
    locations={block.locations}
  />
)}
{block.blockType === "stepBox" && (
  <StepBox
    variant={block.variant}
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    cta={block.cta}
    steps={block.steps}
  />
)}
{block.blockType === "teamGrid" && (
  <TeamGrid
    variant={block.variant}
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    cta={block.cta}
    columns={block.columns}
    members={block.members}
  />
)}
{block.blockType === "pricingTable" && (
  <PricingTable eyebrow={block.eyebrow} heading={block.heading} subheading={block.subheading} tiers={block.tiers} />
)}
{block.blockType === "gallery" && (
  <Gallery
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    columns={block.columns}
    images={block.images}
  />
)}
{block.blockType === "faq" && (
  <Faq
    variant={block.variant}
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    image={block.image}
    items={block.items}
  />
)}
{block.blockType === "list" && (
  <List variant={block.variant} eyebrow={block.eyebrow} heading={block.heading} items={block.items} />
)}
{block.blockType === "richText" && (
  <RichText eyebrow={block.eyebrow} heading={block.heading} columns={block.columns} body={block.body} />
)}
{block.blockType === "video" && (
  <Video
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    poster={block.poster}
    videoFile={block.videoFile}
    videoUrl={block.videoUrl}
    features={block.features}
  />
)}
{block.blockType === "emailOptin" && (
  <EmailOptin
    variant={block.variant}
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    image={block.image}
    showNameField={block.showNameField}
    submitLabel={block.submitLabel}
    formAction={block.formAction}
    disclaimer={block.disclaimer}
  />
)}
{block.blockType === "priceList" && (
  <PriceList
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    columns={block.columns}
    items={block.items}
  />
)}
{block.blockType === "timeline" && (
  <Timeline
    variant={block.variant}
    eyebrow={block.eyebrow}
    heading={block.heading}
    subheading={block.subheading}
    items={block.items}
  />
)}
{block.blockType === "social" && (
  <Social variant={block.variant} heading={block.heading} text={block.text} links={block.links} />
)}
