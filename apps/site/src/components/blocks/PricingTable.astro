---
// Prijskaarten naast elkaar, met een optionele uitgelichte kaart per tarief
// (zie apps/cms/src/blocks/pricingTable.ts).
export interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  tiers: {
    name: string;
    price: string;
    period?: string;
    description?: string;
    features?: { text: string }[];
    cta?: { label?: string; href?: string };
    featured?: boolean;
    badge?: string;
  }[];
}

const { eyebrow, heading, subheading, tiers } = Astro.props;
---

<div class="pricing-table">
  <div class="pricing-table__header">
    {eyebrow && <p class="pricing-table__eyebrow">{eyebrow}</p>}
    <h2 class="pricing-table__heading">{heading}</h2>
    {subheading && <p class="pricing-table__subheading">{subheading}</p>}
  </div>

  <div class="pricing-table__grid">
    {tiers.map((tier) => (
      <div class:list={["pricing-table__tier", { "pricing-table__tier--featured": tier.featured }]}>
        {tier.featured && tier.badge && <span class="pricing-table__badge">{tier.badge}</span>}
        <p class="pricing-table__name">{tier.name}</p>
        <p class="pricing-table__price">
          {tier.price}
          {tier.period && <span class="pricing-table__period">{tier.period}</span>}
        </p>
        {tier.description && <p class="pricing-table__description">{tier.description}</p>}
        {tier.cta?.label && tier.cta?.href && (
          <a class="pricing-table__cta" href={tier.cta.href}>{tier.cta.label}</a>
        )}
        {tier.features && tier.features.length > 0 && (
          <ul class="pricing-table__features">
            {tier.features.map((f) => (
              <li>{f.text}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .pricing-table__header {
    text-align: center;
    max-width: var(--var-max-width-small, 640px);
    margin: 0 auto var(--var-spacing-xl, 3rem);
  }
  .pricing-table__eyebrow {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-bold, 600);
    letter-spacing: var(--var-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    color: var(--var-color-primary, #4338ca);
    margin: 0 0 var(--var-spacing-xs, 0.25rem);
  }
  .pricing-table__heading {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xl, 2rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .pricing-table__subheading {
    opacity: 0.75;
    margin: 0;
  }

  .pricing-table__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--var-spacing-large, 2rem);
    align-items: start;
  }

  .pricing-table__tier {
    position: relative;
    padding: var(--var-spacing-large, 2rem);
    border-radius: var(--var-border-radius-medium, 0.75rem);
    border: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
    background: var(--var-color-white, #fff);
  }
  .pricing-table__tier--featured {
    border-color: var(--var-color-primary, #4338ca);
    box-shadow: var(--var-box-shadow-large, 0 10px 30px rgba(0, 0, 0, 0.08));
    transform: scale(1.03);
  }
  .pricing-table__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.9rem;
    border-radius: var(--var-border-radius-full, 999px);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    font-size: var(--var-font-size-xs, 0.75rem);
    font-weight: var(--var-font-weight-bold, 600);
    white-space: nowrap;
  }
  .pricing-table__name {
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .pricing-table__price {
    font-family: var(--var-font-family-primary, inherit);
    font-size: var(--var-font-size-xxl, 2.5rem);
    font-weight: var(--var-font-weight-bold, 700);
    margin: 0 0 var(--var-spacing-small, 0.5rem);
  }
  .pricing-table__period {
    font-size: var(--var-font-size-small, 0.875rem);
    font-weight: var(--var-font-weight-standard, 400);
    opacity: 0.6;
    margin-left: 0.25rem;
  }
  .pricing-table__description {
    opacity: 0.75;
    font-size: var(--var-font-size-small, 0.875rem);
    margin: 0 0 var(--var-spacing-standard, 1rem);
  }
  .pricing-table__cta {
    display: block;
    text-align: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--var-border-radius-standard, 0.5rem);
    background: var(--var-color-primary, #4338ca);
    color: var(--var-color-white, #fff);
    font-weight: var(--var-font-weight-bold, 600);
    text-decoration: none;
    margin-bottom: var(--var-spacing-standard, 1rem);
  }
  .pricing-table__features {
    list-style: none;
    margin: 0;
    padding: var(--var-spacing-standard, 1rem) 0 0;
    border-top: var(--var-border-width-thin, 1px) solid var(--var-color-light-grey, #e2e8f0);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--var-font-size-small, 0.875rem);
  }
  .pricing-table__features li::before {
    content: "✓ ";
    color: var(--var-color-success, #16a34a);
    font-weight: var(--var-font-weight-bold, 700);
  }
</style>
